APP_NAME=HCR2 Records API
APP_VERSION=0.1.0
ENVIRONMENT=development

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DATABASE_URL=

# Shared secret used to verify the WC_TOKEN login cookie.
AUTH_SHARED_SECRET=
SUBMISSION_RATE_LIMIT_HMAC_SECRET=
ALLOWED_DISCORD_IDS=
# Comma-separated Discord IDs with access to features marked as BETA.
# Only needed if you set a feature flag to BETA. See docs/beta-testing.md.
BETA_DISCORD_IDS=
API_KEYS=

# Feature flags. Values: DISABLED, BETA, ENABLED (ENABLED by default).
# The community features are public. Set DISABLED to hide one behind a 403, or
# BETA to limit it to BETA_DISCORD_IDS and admins.
FEATURE_DISCORD_ACCOUNTS=ENABLED
FEATURE_COMMUNITY_PROFILES=ENABLED
FEATURE_PROFILE_CUSTOMIZATION=ENABLED
FEATURE_COMMUNITY_MEMBERS=ENABLED
FEATURE_PROFILE_REPORTING=ENABLED
FEATURE_COMMUNITY_NOTIFICATIONS=ENABLED

# Minimum days between community username changes (default 7).
# USERNAME_CHANGE_COOLDOWN_DAYS=7
BANNER_CHANGE_COOLDOWN_DAYS=7

HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
