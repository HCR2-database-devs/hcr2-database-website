APP_NAME=HCR2 Records API
APP_VERSION=0.1.0
ENVIRONMENT=development

DB_HOST=127.0.0.1
DB_PORT=54329
DB_NAME=hcr2_dev
DB_USER=hcr2_dev
DB_PASS=hcr2_dev_password
DATABASE_URL=postgresql://hcr2_dev:hcr2_dev_password@127.0.0.1:54329/hcr2_dev

AUTH_SHARED_SECRET=dev-only-hcr2-secret
SUBMISSION_RATE_LIMIT_HMAC_SECRET=dev-only-submission-rate-secret
ALLOWED_DISCORD_IDS=dev-admin
# Comma-separated Discord IDs with access to features marked as BETA.
# Only needed if you set a feature flag to BETA.
BETA_DISCORD_IDS=dev-beta
API_KEYS=dev-api-key

# Feature flags. Values: DISABLED, BETA, ENABLED (ENABLED by default).
FEATURE_DISCORD_ACCOUNTS=ENABLED
FEATURE_COMMUNITY_PROFILES=ENABLED
FEATURE_PROFILE_CUSTOMIZATION=ENABLED
FEATURE_COMMUNITY_MEMBERS=ENABLED
FEATURE_PROFILE_REPORTING=ENABLED
FEATURE_COMMUNITY_NOTIFICATIONS=ENABLED

# Minimum days between community username changes (default 7).
USERNAME_CHANGE_COOLDOWN_DAYS=7
BANNER_CHANGE_COOLDOWN_DAYS=7

HCAPTCHA_SITE_KEY=dev-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=dev-hcaptcha-secret-key

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
