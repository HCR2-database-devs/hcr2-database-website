APP_NAME=HCR2 Records API
APP_VERSION=0.1.0
ENVIRONMENT=development

DB_HOST=
DB_PORT=
DB_NAME=
DB_SCHEMA=
DB_USER=
DB_PASS=
DATABASE_URL=
DB_CONNECT_TIMEOUT=5

AUTH_SHARED_SECRET=
ALLOWED_DISCORD_IDS=
# Comma-separated Discord IDs with access to features marked as BETA.
# See docs/beta-testing.md.
BETA_DISCORD_IDS=
API_KEYS=

# Feature flags. Values: DISABLED, BETA, ENABLED (BETA by default).
# Phase 1/2 community features start out as BETA.
FEATURE_DISCORD_ACCOUNTS=BETA
FEATURE_COMMUNITY_PROFILES=BETA
FEATURE_PROFILE_CUSTOMIZATION=BETA
FEATURE_COMMUNITY_MEMBERS=BETA
FEATURE_PROFILE_REPORTING=BETA

# Minimum days between community username changes (default 30).
# USERNAME_CHANGE_COOLDOWN_DAYS=30

HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

